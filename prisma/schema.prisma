// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model BusinessManager {
  id        Int      @id @default(autoincrement())
  name      String
  bmId      String   @unique
  createdAt DateTime @default(now())

  metaAccounts MetaAccount[]
}

model ShopeeAccount {
  id        Int      @id @default(autoincrement())
  name      String
  shopId    String?  @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  metaAccounts      MetaAccount[]
  commissionImports ShopeeCommissionImport[]
}

model MetaAccount {
  id        Int      @id @default(autoincrement())
  name      String
  accountId String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  businessManagerId Int?
  shopeeAccountId   Int?

  businessManager BusinessManager? @relation(fields: [businessManagerId], references: [id])
  shopeeAccount   ShopeeAccount?   @relation(fields: [shopeeAccountId], references: [id])
  campaigns       Campaign[]
}

model MetaBusinessMappingProgress {
  id                Int       @id
  nextBusinessIndex Int       @default(0)
  completed         Boolean   @default(false)
  lastSyncAt        DateTime?
}

model Campaign {
  id                   Int       @id @default(autoincrement())
  metaCampaignId       String    @unique
  name                 String
  startTime            DateTime?
  metaStatus           String?
  effectiveStatus      String?
  effectiveDailyBudget Decimal?  @db.Decimal(18, 2)
  budgetSource         String
  historySyncedThrough DateTime? @db.Date
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  metaAccountId Int
  metaAccount   MetaAccount @relation(fields: [metaAccountId], references: [id])

  dailyMetrics CampaignDailyMetric[]

  @@index([metaAccountId])
  @@index([metaStatus, effectiveDailyBudget])
}

model CampaignDailyMetric {
  id           Int      @id @default(autoincrement())
  date         DateTime @db.Date
  spend        Decimal? @db.Decimal(18, 2)
  clickFp      Int?
  cpcFp        Decimal? @db.Decimal(18, 4)
  commission   Decimal? @db.Decimal(21, 5)
  shopeeClicks Int?
  note         String?  @db.Text
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, date])
  @@index([date])
}

model ShopeeCommissionImport {
  id                  Int      @id @default(autoincrement())
  originalFilename    String   @db.VarChar(255)
  fileSha256          String   @db.Char(64)
  dateFrom            DateTime @db.Date
  dateTo              DateTime @db.Date
  csvRowCount         Int
  tagCount            Int
  matchedCount        Int
  unmatchedCount      Int
  matchedCommission   Decimal  @db.Decimal(21, 5)
  unmatchedCommission Decimal  @db.Decimal(21, 5)
  createdAt           DateTime @default(now())

  shopeeAccountId Int
  shopeeAccount   ShopeeAccount                     @relation(fields: [shopeeAccountId], references: [id], onDelete: Restrict)
  unmatched       ShopeeCommissionImportUnmatched[]

  @@index([shopeeAccountId, createdAt])
}

model ShopeeCommissionImportUnmatched {
  id         Int      @id @default(autoincrement())
  date       DateTime @db.Date
  tagLink2   String   @db.Text
  commission Decimal  @db.Decimal(21, 5)
  rowCount   Int
  reason     String   @db.VarChar(32)

  importId Int
  import   ShopeeCommissionImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, date])
}
