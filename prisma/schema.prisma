// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model BusinessManager {
  id        Int      @id @default(autoincrement())
  name      String
  bmId      String   @unique
  createdAt DateTime @default(now())

  metaAccounts MetaAccount[]
}

model ShopeeAccount {
  id        Int      @id @default(autoincrement())
  name      String
  shopId    String?  @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  metaAccounts MetaAccount[]
}

model MetaAccount {
  id        Int      @id @default(autoincrement())
  name      String
  accountId String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  businessManagerId Int?
  shopeeAccountId   Int?

  businessManager BusinessManager? @relation(fields: [businessManagerId], references: [id])
  shopeeAccount   ShopeeAccount?   @relation(fields: [shopeeAccountId], references: [id])
}

model MetaBusinessMappingProgress {
  id                Int       @id
  nextBusinessIndex Int       @default(0)
  completed         Boolean   @default(false)
  lastSyncAt        DateTime?
}
